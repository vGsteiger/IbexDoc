{
  "identifier": "default",
  "description": "Default capabilities for DokAssist",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPDATA/exports/*" },
        { "path": "$TEMP/*" }
      ]
    }
  ]
}
